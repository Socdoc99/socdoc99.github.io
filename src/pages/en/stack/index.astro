---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '../../../i18n/strings';
import { stackGroups } from '../../../data/stack';

const locale = 'en' as const;
const strings = t(locale);
---

<BaseLayout
  locale={locale}
  title={`${strings.stack.title} — Santiago Ospina Calle`}
  description={strings.stack.intro}
  pathEs="tecnologias"
  pathEn="stack"
>
  <section class="mx-auto max-w-5xl px-6 py-16">
    <h1 class="text-2xl font-semibold">{strings.stack.title}</h1>
    <p class="mt-2 max-w-2xl text-[var(--fg-muted)]">{strings.stack.intro}</p>

    <div class="mt-8 grid gap-8 sm:grid-cols-2">
      {
        stackGroups.map((group) => (
          <div>
            <h2 class="font-mono text-sm text-[var(--fg-muted)]">{group.label[locale]}</h2>
            <ul class="mt-3 space-y-2">
              {group.items.map((item) => (
                <li class="flex items-baseline gap-2 text-sm text-[var(--fg)]">
                  <span>{item.name[locale]}</span>
                  {item.inPractice && (
                    <span class="font-mono text-xs text-[var(--accent)]">
                      {strings.stack.inPractice}
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
