---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { sectionPath } from '../../../i18n/config';

export async function getStaticPaths() {
  const projects = await getCollection('projects-en');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const locale = 'en' as const;
---

<BaseLayout
  locale={locale}
  title={`${project.data.title} — Santiago Ospina Calle`}
  description={project.data.summary}
  pathEs={`proyectos/${project.id}`}
  pathEn={`projects/${project.id}`}
  image={`og/project/en/${project.id}.png`}
>
  <article class="mx-auto max-w-3xl px-6 py-16">
    <a href={sectionPath(locale, 'projects')} class="font-mono text-sm text-[var(--fg-muted)] hover:text-[var(--fg)]">
      ← Projects
    </a>
    <h1 class="mt-4 text-3xl font-semibold">{project.data.title}</h1>
    <p class="mt-3 font-mono text-xs text-[var(--fg-muted)]">{project.data.stack.join(' · ')}</p>
    <p class="mt-1 font-mono text-xs text-[var(--accent)]">{project.data.status}</p>
    <a
      href={project.data.repoUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-4 inline-block rounded border border-[var(--border)] px-3 py-1.5 font-mono text-sm text-[var(--fg-muted)] transition-colors hover:text-[var(--fg)]"
    >
      View repository →
    </a>
    <div class="prose-content mt-8">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .prose-content :global(h2) {
    margin-top: 2rem;
    font-size: 1.125rem;
    font-weight: 600;
  }
  .prose-content :global(p) {
    margin-top: 0.75rem;
    line-height: 1.7;
    color: var(--fg);
  }
  .prose-content :global(pre) {
    margin-top: 0.75rem;
    overflow-x: auto;
    border-radius: 0.25rem;
    border: 1px solid var(--border);
    background: var(--bg-raised);
    padding: 1rem;
    font-size: 0.8125rem;
  }
  .prose-content :global(strong) {
    color: var(--fg);
  }
</style>
