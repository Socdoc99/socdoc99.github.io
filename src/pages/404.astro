---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n/strings';
import { localePath } from '../i18n/config';

const locale = Astro.url.pathname.startsWith('/en') ? ('en' as const) : ('es' as const);
const strings = t(locale);
---

<BaseLayout
  locale={locale}
  title={`404 — ${strings.notFound.title}`}
  description={strings.notFound.body}
  pathEs=""
  pathEn=""
>
  <section class="mx-auto max-w-5xl px-6 py-20 text-center">
    <p class="font-mono text-sm text-[var(--accent)]">404</p>
    <h1 class="mt-3 text-3xl font-semibold leading-tight sm:text-4xl">{strings.notFound.title}</h1>
    <p class="mt-4 text-[var(--fg-muted)]">{strings.notFound.body}</p>
    <a
      href={localePath(locale)}
      class="mt-8 inline-block font-mono text-sm text-[var(--accent)] hover:underline"
    >
      {strings.notFound.cta} →
    </a>
  </section>
</BaseLayout>
