---
interface Props {
  href: string;
  title: string;
  summary: string;
  stack: string[];
  status: string;
}

const { href, title, summary, stack, status } = Astro.props;
---

<a
  href={href}
  class="group block rounded border border-[var(--border)] p-5 transition-colors hover:border-[var(--accent)]"
>
  <h3 class="text-lg font-semibold text-[var(--fg)]">{title}</h3>
  <p class="mt-2 text-sm text-[var(--fg-muted)]">{summary}</p>
  <p class="mt-3 font-mono text-xs text-[var(--fg-muted)]">{stack.join(' · ')}</p>
  <p class="mt-3 font-mono text-xs text-[var(--accent)]">{status}</p>
</a>
