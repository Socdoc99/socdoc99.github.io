---
import { CONTACT } from '../config/site';
import { t } from '../i18n/strings';
import type { Locale } from '../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = t(locale);

// Only fields verifiable from config/site.ts and already shown in plain
// text on /contacto — no invented jobTitle, worksFor, etc.
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: strings.hero.name,
  url: Astro.site?.toString(),
  email: `mailto:${CONTACT.email}`,
  sameAs: [CONTACT.linkedin, CONTACT.github],
};
---

<script type="application/ld+json" set:html={JSON.stringify(person)} />
