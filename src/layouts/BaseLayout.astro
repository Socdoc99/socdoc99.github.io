---
import '../styles/global.css';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import Nav from '../components/Nav.astro';
import CursorField from '../components/CursorField.astro';
import { localePath, type Locale } from '../i18n/config';
import { t } from '../i18n/strings';
import manropeWoff2 from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import jetbrainsMonoWoff2 from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** This page's path in Spanish (no leading/trailing slash, no locale segment; '' for home). */
  pathEs: string;
  /** This page's path in English (no leading/trailing slash, no locale segment; '' for home). */
  pathEn: string;
  /** OG image path (no leading slash), e.g. `og/project/es/01-lsc-app.png`. Defaults to the generic per-locale image. */
  image?: string;
}

const { locale, title, description, pathEs, pathEn, image } = Astro.props;
const strings = t(locale);
const ownPath = locale === 'es' ? pathEs : pathEn;
const canonicalUrl = new URL(localePath(locale, ownPath), Astro.site);
const esUrl = new URL(localePath('es', pathEs), Astro.site);
const enUrl = new URL(localePath('en', pathEn), Astro.site);
const ogImageUrl = new URL(image ?? `og/default/${locale}.png`, Astro.site);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0b0f14" />

    <!--
      Preloaded so the variable fonts are available before first paint —
      otherwise the fallback-to-webfont swap reflows the page (observed as a
      0.3 CLS in Lighthouse on first load).
    -->
    <link rel="preload" as="font" type="font/woff2" href={manropeWoff2} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={jetbrainsMonoWoff2} crossorigin />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={locale === 'es' ? 'es_CO' : 'en_US'} />
    <meta property="og:locale:alternate" content={locale === 'es' ? 'en_US' : 'es_CO'} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
  </head>
  <body class="text-[var(--fg)] antialiased">
    <CursorField />
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-[var(--accent)] focus:px-4 focus:py-2 focus:text-[var(--accent-fg)]"
    >
      {locale === 'es' ? 'Saltar al contenido' : 'Skip to content'}
    </a>

    <header class="border-b border-[var(--border)]">
      <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-4 px-6 py-4">
        <a href={localePath(locale)} class="font-mono text-sm text-[var(--fg)]">
          {strings.hero.name}
        </a>
        <Nav locale={locale} />
        <LanguageSwitcher
          locale={locale}
          targetPath={locale === 'es' ? pathEn : pathEs}
          label={strings.language.switchTo}
        />
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="border-t border-[var(--border)]">
      <div class="mx-auto max-w-5xl px-6 py-8 font-mono text-xs text-[var(--fg-muted)]">
        <p>&copy; {new Date().getFullYear()} {strings.hero.name}</p>
      </div>
    </footer>
  </body>
</html>
